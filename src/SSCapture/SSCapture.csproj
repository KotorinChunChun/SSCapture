<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>0.1.11.0</AssemblyVersion>
    <FileVersion>0.1.11.0</FileVersion>
    <InformationalVersion>0.1.11</InformationalVersion>
    <Version>0.1.11</Version>
    <ProductChannel>beta</ProductChannel>
    <ProductUpdatedOn>2026-11-22</ProductUpdatedOn>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AppHostDotNetSearch Condition="'$(SelfContained)' != 'true'">AppRelative;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet Condition="'$(SelfContained)' != 'true'">../../.tools/dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch Condition="'$(SelfContained)' == 'true'">AppLocal</AppHostDotNetSearch>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SSCapture.Tests" />
    <AssemblyMetadata Include="ProductChannel" Value="$(ProductChannel)" />
    <AssemblyMetadata Include="ProductUpdatedOn" Value="$(ProductUpdatedOn)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="capture-key-defaults.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <EmbeddedResource Include="capture-key-defaults.json" LogicalName="capture-key-defaults.json" />
  </ItemGroup>
  <ItemGroup><PackageReference Include="NAudio.Wasapi" Version="3.1.0" /></ItemGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WindowsForms" RuntimeFrameworkVersion="10.0.15" Condition="'$(SelfContained)' == 'true'" />
    <KnownFrameworkReference Update="Microsoft.WindowsDesktop.App;Microsoft.WindowsDesktop.App.WindowsForms" DefaultRuntimeFrameworkVersion="10.0.15" LatestRuntimeFrameworkVersion="10.0.15" Condition="'$(SelfContained)' == 'true'" />
  </ItemGroup>
</Project>
